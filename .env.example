DISCORD_TOKEN=
# Optional legacy single-server import settings. For a new deployment leave blank
# and run /rating setup in each Discord server.
GUILD_ID=
# Explicit original owner of a legacy database; must match GUILD_ID to import.
# Leave blank to disable legacy import (safe default).
LEGACY_GUILD_ID=
# Optional: comma-separated moderator role IDs; empty means no extra moderators.
MODERATOR_ROLE_IDS=
# Optional: empty uses Discord Administrator permission; configured IDs override fallback.
ADMIN_ROLE_IDS=
# Optional legacy import channel. New guilds select the report channel in /rating setup.
DAILY_REPORT_CHANNEL_ID=
# Optional: empty stores punishments/undos in SQLite without channel notifications.
MODERATION_LOG_CHANNEL_ID=
# Base path: creates data/rating.guilds/registry.db and one <guild_id>.db per opted-in guild.
DATABASE_URL=sqlite+aiosqlite:///./data/rating.db
START_RATING=800
DAILY_REWARD=25
PUNISHMENT_AMOUNT=50
MIN_MESSAGES=5
PAYOUT_TIME=18:00
TIMEZONE=Europe/Kyiv
LOG_LEVEL=INFO
MESSAGE_RETENTION_DAYS=35
RECOVERY_LOOKBACK_DAYS=35

# Необязательный HTTP(S)-прокси для окружений с ограниченным прямым доступом.
DISCORD_PROXY=
